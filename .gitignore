# Experiment outputs. `runs/` and `results/` above are the current convention;
# these four are the pre-`runs/` top-level layout kept for the 2026-08-08/10
# ablations. All are regenerable and none are referenced by any report.
artifacts/
products/
spectra/
records/
logs/

# Generated figures (regenerable via experiments/reduced_state_emulator/make_figures.py)
figures/

# Working snapshots
*.zip

# Local agent/editor state and checkout-only notes
.claudian/
.obsidian/
MEMORY.md

# Large local research payloads.  Their compact manifests and closeout notes
# are versioned separately.
archive/
SDSS_MARCS_atmospheres.h5
refcheck/

